<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- false so Android's Auto Backup (cloud + device-to-device transfer) never snapshots
         the app's SharedPreferences - that's where @capacitor/preferences (mobile/app.js's
         storageGet/storageSet) keeps the login token and onboardingSeen flag. With this
         true, uninstalling and reinstalling restored that old token (bouncing the visitor
         back to Login once the dead session was rejected server-side) and the old
         onboardingSeen (skipping the onboarding slides on what should look like a fresh
         install). -->
    <!-- Opts out of Android 16's predictive-back default (targetSdkVersion 36, see
         variables.gradle) - on a device running Android 16+, leaving this unset means
         onBackPressed()/dispatchKeyEvent() stop being called and KeyEvent.KEYCODE_BACK
         is never dispatched at all (per Android's own Android 16 behavior-change docs),
         which silently breaks MainActivity.dispatchKeyEvent()'s overlay-vs-keyboard fix
         (see that method's own comment) - it simply never runs, and the app falls back
         to the WebView eating the first back press to hide the keyboard, needing a
         second press to close the popup. Capacitor's own backButton handling (AppPlugin,
         registered via OnBackPressedCallback/getOnBackPressedDispatcher()) is documented
         to run "regardless of the value of android:enableOnBackInvokedCallback", so this
         only restores the legacy KeyEvent path our own code depends on. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Verified Android App Link for the "Continue with Google" mobile bridge
                 (see app.py's auth_google_done, mobile/app.js's appUrlOpen listener, and
                 the assetlinks.json route below it). Host matches API_BASE
                 (mobile/app.js) - app.ai-auto-reply-mail.com, not the bare domain - since
                 that's the actual host app.py's routes (including this one) are served
                 from. autoVerify tells Android to check /.well-known/assetlinks.json for
                 this host at install time and, once verified, hand navigation to this
                 exact path straight to this app instead of loading it in Chrome/a Custom
                 Tab - closing that Custom Tab as part of the OS-level handoff, with no
                 page ever rendered in it. Scoped to this one path (not the whole domain)
                 - auth_google_callback (Google's own OAuth redirect target) must NOT be
                 App-Link-verified, or Android would intercept Google's own redirect
                 before it ever reached the server to exchange the code at all. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="app.ai-auto-reply-mail.com"
                    android:pathPrefix="/auth/google/done" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for the WebView's getUserMedia mic recording (My Site's "Draft this with
         AI" voice input) - Capacitor's WebChromeClient can only request a runtime
         permission, and thus show the native "Allow app to use microphone" system prompt,
         for permissions declared here. Without this, getUserMedia rejects immediately with
         NotAllowedError and no system dialog is ever shown.
         Both permissions below are requested by Capacitor as ONE batch for an audio
         capture request (see BridgeWebChromeClient#onPermissionRequest) - MODIFY_AUDIO_SETTINGS
         is a normal (non-prompted) permission but still has to be declared here or the whole
         batch is treated as not fully granted and the WebView denies the request even after
         the user taps Allow on the RECORD_AUDIO system dialog. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
</manifest>
