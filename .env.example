OPENAI_API_KEY=
FLASK_SECRET_KEY=
ENCRYPTION_KEY=
RESEND_API_KEY=
FLASK_DEBUG=false
DATABASE_URL=
# Mejl na koji stizu upozorenja kad obrada nekog biznisa pukne u worker petlji
ALERT_EMAIL=
# Folder za dnevne JSON backupe baze (na Railway-u: /data/backups). Prazno = bez backupa.
BACKUP_DIR=

# Paddle pretplata. PADDLE_ENV = sandbox (za test) ili production (prava naplata).
# Client token i price ID-jevi su vidljivi na frontendu (Paddle.js checkout ide direktno
# iz browsera); webhook secret je tajan. 4 price ID-a = Starter/Pro x mesecno/godisnje -
# svaki ima svoj 14-dnevni trial i "obavezna kartica tokom trial-a" podeseno u Paddle
# dashboard-u na samom Price objektu, ne u kodu.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_WEBHOOK_SECRET=

# Secret token that gates /admin/analytics (e.g. /admin/analytics?token=...)
ADMIN_TOKEN=

# Cloudinary - object storage/CDN for business-uploaded media (website photos/video today,
# see storage.py; reused by any future upload feature so there's one storage integration,
# not one per feature). Railway/Heroku-style deploys have an ephemeral filesystem, so
# uploads are never written to local disk - this is the only place they're kept. Get this
# from Cloudinary dashboard > Account Details > "API Environment variable" (already in the
# cloudinary://<key>:<secret>@<cloud_name> form - paste the whole thing). Empty = uploads
# are rejected with a clear error instead of silently no-op'ing.
CLOUDINARY_URL=

# Firebase Cloud Messaging - stvarne push notifikacije ka Android aplikaciji (vlasnikovi
# podsetnici o terminu i nove poruke). Bez ovoga app i dalje radi, samo push ne stize -
# ostaje samo notifikacija unutar aplikacije (zvonce). Vidi push_notifications.py.
# FIREBASE_PROJECT_ID - Firebase konzola > Project settings > General > "Project ID"
# FIREBASE_SERVICE_ACCOUNT_JSON - Firebase konzola > Project settings > Service accounts
#   > "Generate new private key", pa ceo sadrzaj preuzetog .json fajla nalepi u jedan red
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# "Continue with Google" (dugme na Log in / Register, web i mobilna app). Prazno = dugme
# se uopste ne prikazuje (google_oauth.is_configured() vraca False), sajt/app rade
# identicno kao pre ove opcije. Da bi provera stvarno radila:
#   1. Google Cloud Console (console.cloud.google.com) > kreiraj/otvori projekat >
#      "APIs & Services" > "Credentials" > "Create Credentials" > "OAuth client ID" >
#      Application type = "Web application".
#   2. "Authorized redirect URIs" - dodaj TACNO
#      https://<tvoj-domen>/auth/google/callback (i https://localhost:5000/auth/google/callback
#      ili sta vec koristis za lokalni test, ako testiras lokalno) - i web i mobilna app
#      koriste ISTU ovu jednu rutu, druga se ne dodaje.
#   3. Kopiraj "Client ID" i "Client secret" ispod. Ako je OAuth consent screen jos u
#      "Testing" modu, samo Google nalozi dodati kao test users mogu da se uloguju - stavi
#      ga u "Production" kad bude spremno za sve korisnike.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcioni link za dobrovoljne donacije (npr. paypal.me/korisnickoime), prikazan na
# stranici pretplate i u footeru sajta dok je BETA_FREE_MODE ukljucen. Prazno = sekcija
# se ne prikazuje nigde.
DONATION_LINK=

# Ispod su potrebni samo za rucno testiranje read_email.py iz terminala
# (obicni flow za CITANJE ide preko po-biznis kredencijala iz baze, ne preko ovih.
# Slanje ide iskljucivo preko Resend-a, EMAIL_APP_PASSWORD se za slanje vise ne koristi)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
