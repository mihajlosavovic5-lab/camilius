OPENAI_API_KEY=
FLASK_SECRET_KEY=
ENCRYPTION_KEY=
RESEND_API_KEY=
FLASK_DEBUG=false
DATABASE_URL=
# Mejl na koji stizu upozorenja kad obrada nekog biznisa pukne u worker petlji
ALERT_EMAIL=
# Folder za dnevne JSON backupe baze (na Railway-u: /data/backups). Prazno = bez backupa.
BACKUP_DIR=

# Paddle pretplata. PADDLE_ENV = sandbox (za test) ili production (prava naplata).
# Client token i price ID-jevi su vidljivi na frontendu (Paddle.js checkout ide direktno
# iz browsera); webhook secret je tajan. 4 price ID-a = Starter/Pro x mesecno/godisnje -
# svaki ima svoj 14-dnevni trial i "obavezna kartica tokom trial-a" podeseno u Paddle
# dashboard-u na samom Price objektu, ne u kodu.
PADDLE_ENV=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER_MONTHLY=
PADDLE_PRICE_STARTER_YEARLY=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_WEBHOOK_SECRET=

# Secret token that gates /admin/analytics (e.g. /admin/analytics?token=...)
ADMIN_TOKEN=

# Instagram DM kanal (instagram_api.py) - App ID/Secret sa Meta App dashboard-a, i bilo
# koji string za WEBHOOK_VERIFY_TOKEN (upisuje se i u Meta App dashboard-u, u polju za
# webhook). Ovo je bilo nedostajalo ovde iako je oduvek obavezno - dodato uz WhatsApp
# ispod da oba kanala budu dokumentovana na jednom mestu.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# WhatsApp DM kanal (whatsapp_api.py) - drugi, nezavisan kanal pored Instagrama. Za razliku
# od Instagrama nema OAuth razmenu (svaki biznis nalepi svoj sopstveni token u Podesavanjima
# - vidi whatsapp_api.py-jev docstring za zasto), pa ovde treba samo App Secret (za
# proveru potpisa webhook poziva) i verify token (isto kao Instagram-ov, bilo koji string,
# upisuje se u Meta App dashboard-u).
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Messenger DM kanal (messenger_api.py) - treci kanal. Za razliku od WhatsApp-a OVDE
# postoji prava OAuth razmena (Facebook Login, ne Instagram Login), pa treba i App ID -
# moze biti ista Meta App kao za Instagram (isti App ID/Secret) ako je Messenger dodat kao
# proizvod na tu istu app, ili posebna app ako se tako vodi.
MESSENGER_APP_ID=
MESSENGER_APP_SECRET=
MESSENGER_WEBHOOK_VERIFY_TOKEN=

# Firebase Cloud Messaging - stvarne push notifikacije ka Android aplikaciji (vlasnikovi
# podsetnici o terminu i nove poruke). Bez ovoga app i dalje radi, samo push ne stize -
# ostaje samo notifikacija unutar aplikacije (zvonce). Vidi push_notifications.py.
# FIREBASE_PROJECT_ID - Firebase konzola > Project settings > General > "Project ID"
# FIREBASE_SERVICE_ACCOUNT_JSON - Firebase konzola > Project settings > Service accounts
#   > "Generate new private key", pa ceo sadrzaj preuzetog .json fajla nalepi u jedan red
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opcioni link za dobrovoljne donacije (npr. paypal.me/korisnickoime), prikazan na
# stranici pretplate i u footeru sajta dok je BETA_FREE_MODE ukljucen. Prazno = sekcija
# se ne prikazuje nigde.
DONATION_LINK=

# Ispod su potrebni samo za rucno testiranje read_email.py iz terminala
# (obicni flow za CITANJE ide preko po-biznis kredencijala iz baze, ne preko ovih.
# Slanje ide iskljucivo preko Resend-a, EMAIL_APP_PASSWORD se za slanje vise ne koristi)
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
